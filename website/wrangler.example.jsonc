{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simple-jev-pages-local",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-10-06",
  "d1_databases": [
    {
      "binding": "SF_SIGNAL_DB",
      "database_name": "sf-signal-local",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "vars": {
    "SF_SIGNAL_CLASSIFIER_ENDPOINT": "https://simple-jev-demo-api.featherless.ai/v1/classifier"
  }
}
